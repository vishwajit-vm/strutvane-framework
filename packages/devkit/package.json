{
  "name": "@strutvane/devkit",
  "version": "0.1.0-next.0",
  "description": "SDK for Strutvane installers, generators and upgrades: staged transactional file writes, .env/.env.example editing, package.json and config patching, and a normalising three-way merge engine.",
  "keywords": [
    "strutvane",
    "typescript",
    "sdk",
    "installer",
    "generator",
    "codemod",
    "scaffolding",
    "three-way-merge"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-devkit#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-devkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-devkit.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@strutvane/contracts": "0.1.0-next.0",
    "diff": "9.0.0",
    "magicast": "0.5.5",
    "node-diff3": "3.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
