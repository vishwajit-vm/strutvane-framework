import { definePolicy } from '@strutvane/auth'

/**
 * Who may do what with invoices. Deny-by-default: anything not allowed here is
 * refused, and `deny` always wins over `allow`. Rules compile to SQL, so lists are filtered in
 * the database. Generated by `sv make:policy`; this file is yours to edit.
 */
export default definePolicy('invoice', ({ allow }) => {
  allow(['viewAny', 'create'], { role: ['member', 'admin'] })
  // Members see and change only their own records (needs an ownerId field).
  allow(['view', 'update', 'delete'], { when: ({ actor, row }) => row.ownerId.eq(actor.id) })
  allow(['view', 'update', 'delete', 'export', 'restore', 'forceDelete'], { role: 'admin' })
})
