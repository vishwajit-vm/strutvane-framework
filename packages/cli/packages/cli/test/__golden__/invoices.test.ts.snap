import { describe, expect, test } from 'vitest'
import { actingAs, testApp } from '@strutvane/framework/testing'
import InvoiceFactory from '../../database/factories/invoice.factory.ts'

describe('Invoice API', () => {
  test('lists invoices with invoice.viewAny', async () => {
    const app = await testApp()
    await InvoiceFactory.createMany(3)
    const res = await actingAs(app, { permissions: ['invoice.viewAny'] }).get('/api/v1/invoices')
    expect(res.status).toBe(200)
    expect(res.body.data).toHaveLength(3)
  })

  test('denies access without a permission (deny-by-default)', async () => {
    const app = await testApp()
    const res = await actingAs(app, { permissions: [] }).get('/api/v1/invoices')
    expect(res.status).toBe(403)
  })

  test('creates a new invoice', async () => {
    const app = await testApp()
    const input = await InvoiceFactory.attributes()
    const res = await actingAs(app, { permissions: ['invoice.create'] }).post('/api/v1/invoices', input)
    expect(res.status).toBe(201)
  })
})
