import { defineResource } from '@strutvane/framework'
import Invoice from '../models/invoice.model.ts'

/**
 * API and UI behaviour for invoices: custom actions (each gets a route, a
 * permission and a UI button) and lifecycle hooks. Generated by `sv make:resource`.
 */
export default defineResource(Invoice, {
  actions: {
    approve: { label: 'Approve' },
    sendReminder: { label: 'Send reminder' },
  },
  hooks: {
    async beforeCreate(input, ctx) {
      // beforeCreate logic for invoice records
      void [input, ctx]
    },

    async afterUpdate(record, previous, ctx) {
      // afterUpdate logic for invoice records
      void [record, previous, ctx]
    },
  },
})
