import { definePolicy } from '@strutvane/auth'
import { policySchema } from '@strutvane/framework'
import Invoice from '../models/invoice.model.ts'

/**
 * Who may do what with invoices. Deny-by-default: anything not allowed here is
 * refused, and `deny` always wins over `allow`. Rules compile to SQL, so lists are filtered in
 * the database. Generated by `sv make:policy`; this file is yours to edit.
 */
export default definePolicy('invoice', { schema: policySchema(Invoice) }, ({ allow }) => {
  allow(['viewAny', 'view'], { role: ['member', 'admin'] })
  allow(['create', 'update', 'delete', 'export', 'restore', 'forceDelete'], { role: 'admin' })
})
