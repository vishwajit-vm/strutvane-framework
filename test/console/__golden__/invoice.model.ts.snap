import { defineModel, field } from '@strutvane/framework'

/**
 * Invoice: one row of `invoices`. Fields drive the migration, validation, the API,
 * OpenAPI and the UI. Generated by `node strut make:model`; this file is yours to edit.
 */
export default defineModel(
  'Invoice',
  {
    number: field.string(40).required().unique().searchable(),
    customer: field.belongsTo('Customer').filterable(),
    amount: field.decimal(12, 2).min(0).sortable(),
    status: field.enum(['draft', 'sent', 'paid']).default('draft').filterable(),
    dueDate: field.date().label('Due date'),
    paid: field.boolean().default(false),
    lines: field.hasMany('InvoiceLine'),
  },
  { timestamps: true, softDeletes: true, tenant: true },
)
