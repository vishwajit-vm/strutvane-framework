import { defineFactory } from '@strutvane/framework/testing'
import Invoice from '../../app/models/invoice.model.ts'

/** Realistic fake invoices for tests and seeders. Generated by `sv make:factory`. */
export default defineFactory(Invoice, ({ fake, related }) => ({
  number: fake.words(3),
  customer: related('Customer'),
  amount: fake.decimal({ min: 0, max: 10000, scale: 2 }),
  status: fake.pick(['draft', 'sent', 'paid']),
  dueDate: fake.date(),
  paid: fake.boolean(),
  // lines: hasMany is not generated by the factory
}))
