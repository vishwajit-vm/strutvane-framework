{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@strutvane/framework": ["./lib/strutvane.ts"],
      "@strutvane/framework/http": ["./lib/strutvane.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
