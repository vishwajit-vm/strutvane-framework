# npm settings for this repo (npm >= 11.19). They replace the pnpm-workspace.yaml guards
# (allowBuilds + minimumReleaseAge) that left with pnpm. Never put tokens here.
#
# Install scripts run only for dependencies approved in package.json "allowScripts" (pinned
# pkg@version entries, managed with `npm approve-scripts`); any other script fails the install.
strict-allow-scripts=true
# Third-party versions must be at least a day old before they can be installed (pnpm's default
# minimumReleaseAge). Our own pre-releases are staged and approved with 2FA (ADR-0018), so they
# are exempt.
min-release-age=1
min-release-age-exclude[]=@strutvane/*
# No dependencies from git URLs, and the Node version in "engines" is enforced.
allow-git=none
engine-strict=true
