{
  "name": "@strutvane/framework",
  "version": "0.2.0-next.1",
  "description": "The Strutvane backend and database core: model DSL, migrations, data access with tenant isolation, an automatic CRUD API with OpenAPI, storage and uploads, and testing helpers, plus the kernel (core), shared contracts, the CLI (console) and the installer/generator SDK (devkit).",
  "keywords": [
    "strutvane",
    "typescript",
    "framework",
    "backend",
    "orm",
    "migrations",
    "crud",
    "rest-api",
    "openapi",
    "multi-tenancy"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-framework#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-framework.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "default": "./dist/provider.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "default": "./dist/http.mjs"
    },
    "./database": {
      "types": "./dist/database.d.mts",
      "default": "./dist/database.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./commands": {
      "types": "./dist/commands.d.mts",
      "default": "./dist/commands.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "default": "./dist/testing/index.mjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.mts",
      "default": "./dist/contracts/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "default": "./dist/core/index.mjs"
    },
    "./devkit": {
      "types": "./dist/devkit/index.d.mts",
      "default": "./dist/devkit/index.mjs"
    },
    "./console": {
      "types": "./dist/console/index.d.mts",
      "default": "./dist/console/index.mjs"
    },
    "./facades": {
      "types": "./dist/facades/index.d.mts",
      "default": "./dist/facades/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "strutvane": "dist/console/bin.mjs",
    "strutvane-cli": "dist/console/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown && node scripts/smoke-dist.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:tripwire": "vitest run --config vitest.tripwire.config.ts",
    "test:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@hono/zod-openapi": "1.6.3",
    "busboy": "1.6.0",
    "diff": "9.0.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "magicast": "0.5.5",
    "node-diff3": "3.2.1",
    "oxc-parser": "0.158.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5.16",
    "@libsql/client": ">=0.18.0",
    "mysql2": ">=3.24.6",
    "pg": ">=8.23.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@electric-sql/pglite": "0.5.16",
    "@libsql/client": "0.18.0",
    "@readme/openapi-parser": "10.0.0",
    "@types/busboy": "1.5.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "strutvane": {
    "commands": "./dist/commands.mjs",
    "compat": "^0.2.0-next.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
